[
  {
    "label": "Configure Debug",
    "command": "cmake",
    "args": [
      "-G Ninja",
      "-S .",
      "-B cmake-build-debug",
      "-D CMAKE_BUILD_TYPE=Debug"
    ],
    "env": {},
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Configure Release",
    "command": "cmake",
    "args": [
      "-G Ninja",
      "-S .",
      "-B cmake-build-release",
      "-D CMAKE_BUILD_TYPE=Release"
    ],
    "env": {},
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Build Debug",
    "command": "cmake --build . --parallel",
    "args": [],
    "env": {},
    "cwd": "$ZED_WORKTREE_ROOT/cmake-build-debug",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Build Release",
    "command": "cmake --build . --parallel",
    "args": [],
    "env": {},
    "cwd": "$ZED_WORKTREE_ROOT/cmake-build-release",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Build and Test Debug",
    "command": "cmake --build . --parallel && ctest --verbose",
    "args": [],
    "env": {},
    "cwd": "$ZED_WORKTREE_ROOT/cmake-build-debug",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Build and Test Release",
    "command": "cmake --build . --parallel && ctest --verbose",
    "args": [],
    "env": {},
    "cwd": "$ZED_WORKTREE_ROOT/cmake-build-release",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  }
]
